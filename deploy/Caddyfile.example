# C:\server\caddy\Caddyfile 예시 · ip주소.md(2026-09-22) 기준
# - 80/443 이 공유기에서 서버 내부 IP 로 포트포워딩되어 있어야 인증서가 발급됩니다.
# - 도메인 cleanguard.duckdns.org 와 live.cleanguard.duckdns.org 는 DuckDNS 가 공인 IP 로 갱신한다
# - 비밀번호 해시는  caddy hash-password  로 만들고, 해시 값만 이 파일에 둡니다.
# - FastAPI 가 /api/events(GET) 와 /ws/events 에 Basic Auth 를 걸 때, realm 을 "Clean Guard" 로 맞추면
#   브라우저가 대시보드 로그인 창에서 입력한 계정을 그대로 재사용합니다.

{
	email admin@example.com
}

cleanguard.duckdns.org {
	encode gzip

	# 젯슨 이벤트 POST(Bearer 토큰), 사건 조회, WebSocket → FastAPI (127.0.0.1:8010)
	# 인증은 FastAPI 가 처리합니다 (POST: Bearer 장비토큰 / GET·WS: 대시보드 Basic Auth)
	handle /api/* {
		reverse_proxy 127.0.0.1:8010
	}
	handle /ws/* {
		reverse_proxy 127.0.0.1:8010
	}

	# 사건 스냅샷 (C:\server\app\snapshots) · 대시보드 계정으로 보호
	handle_path /snapshots/* {
		basic_auth bcrypt "Clean Guard" {
			dashboard $2a$14$REPLACE_WITH_caddy_hash-password_OUTPUT
		}
		root * C:/server/app/snapshots
		file_server
	}

	# 대시보드 정적 파일 (이 저장소의 index.html + assets/ 를 C:\server\dashboard 에 복사)
	handle {
		basic_auth bcrypt "Clean Guard" {
			dashboard $2a$14$REPLACE_WITH_caddy_hash-password_OUTPUT
		}
		root * C:/server/dashboard
		file_server
		header Cache-Control "no-store"
	}
}

# 실시간 영상 · MediaMTX WebRTC(8889) 시그널링. 미디어(UDP 8189)는 공유기에서 직접 포워딩.
# viewer 계정 인증은 MediaMTX 가 처리하므로 여기서는 basic_auth 를 걸지 않습니다.
live.cleanguard.duckdns.org {
	reverse_proxy 127.0.0.1:8889
}
